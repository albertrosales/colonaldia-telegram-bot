# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...
# IDs de chat autorizados, separados por coma
ALLOWED_CHAT_ID=123456789

# OpenAI
OPENAI_API_KEY=sk-...
# Modelo para verificar en la web, redactar y editar (debe soportar la herramienta web_search)
OPENAI_MODEL=gpt-5.4
# Modelo barato para tareas simples (palabras clave, comparar duplicados)
OPENAI_MODEL_RAPIDO=gpt-4o-mini

# WordPress
WP_URL=https://colonaldia.hn
WP_USER=tu_usuario
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Autores opcionales: id:Nombre separados por coma
WP_AUTHORS=2:Alberto,3:Redacción

# Render la define sola; no la pongas en Render
# RENDER_EXTERNAL_URL=
